import shutil
import subprocess
import tomllib
from pathlib import Path


script_dir = Path(__file__).resolve().parent
project_dir = script_dir.parent

# Before deleting the vendor directory, save some files from it
vendor_saved_files = {}
for file in ['.clang-format', 'README.md']:
    with open(project_dir / 'rust' / 'vendor' / file, 'r') as vendor_file:
        vendor_saved_files[file] = vendor_file.read()

# cargo vendor-filterer won't run if the vendor directory exists
shutil.rmtree(project_dir / 'rust' / 'vendor')

# Remove vendor instructions from config.toml
config_toml_path = project_dir / '.cargo' / 'config.toml'
with open(config_toml_path, 'r') as config_toml:
    config_toml_contents = config_toml.read().splitlines() + ['']
config_toml_begin_vendor_settings_line = config_toml_contents.index(
    '# BEGIN VENDOR SETTINGS')
config_toml_end_vendor_settings_line = config_toml_contents.index(
    '# END VENDOR SETTINGS')
for line in range(config_toml_begin_vendor_settings_line + 1, config_toml_end_vendor_settings_line):
    config_toml_contents[line] = '#' + config_toml_contents[line]
with open(config_toml_path, 'w') as config_toml:
    config_toml.write('\n'.join(config_toml_contents))

# Update dependencies
subprocess.run(
    ['cargo', 'update'],
    cwd=project_dir,
    stderr=subprocess.STDOUT)

# Read new crate versions
with open(project_dir / 'Cargo.lock', 'rb') as cargo_lock:
    crate_versions = {
        package['name']: package['version']
        for package in tomllib.load(cargo_lock)['package']
    }

# Replace crate versions in Cargo.toml
cargo_toml_path = project_dir / 'Cargo.toml'
with open(cargo_toml_path, 'r') as cargo_toml:
    cargo_toml_lines = cargo_toml.read().splitlines()
for line_number, line in enumerate(cargo_toml_lines):
    for crate_name, crate_version in crate_versions.items():
        line_start = f'    {{ name = "{crate_name}-'
        if line.startswith(line_start):
            version_end = line.index('"', len(line_start))
            cargo_toml_lines[line_number] = line_start + \
                crate_version + line[version_end:]
            break
with open(cargo_toml_path, 'w') as cargo_toml:
    cargo_toml.write('\n'.join(cargo_toml_lines) + '\n')

# Vendor the updated dependencies
subprocess.run(
    ['cargo', 'vendor-filterer', '--versioned-dirs'],
    cwd=project_dir,
    stderr=subprocess.STDOUT)

# Restore vendor instructions to config.toml
for line in range(
        config_toml_begin_vendor_settings_line + 1,
        config_toml_end_vendor_settings_line):
    config_toml_contents[line] = config_toml_contents[line][1:]
with open(config_toml_path, 'w') as config_toml:
    config_toml.write('\n'.join(config_toml_contents))

# Move vendor directory into final location
shutil.move(project_dir / 'vendor', project_dir / 'rust')

# Restore saved files
for file, contents in vendor_saved_files.items():
    with open(project_dir / 'rust' / 'vendor' / file, 'w') as vendor_file:
        vendor_file.write(contents)
