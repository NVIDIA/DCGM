set -euo pipefail

PROJECT_DIR="$(dirname "$(dirname "$(realpath "$0")")")"

readonly DENIED_DIRECTORIES=(
    "${PROJECT_DIR}/rust/vendor"
)

FIND_ARGUMENTS=("${PROJECT_DIR}" -type f -name '*.py')
for directory in "${DENIED_DIRECTORIES[@]}"; do
    FIND_ARGUMENTS+=(-not -path "${directory}/*")
done

find "${FIND_ARGUMENTS[@]}" -print0 \
    | xargs -0 --no-run-if-empty python3 -m py_compile
